# Original art. Lives on disk, never in the repo — the build writes optimised
# derivatives into assets/ and only those get committed.
_source/

# Python bytecode from running the tools
__pycache__/

# macOS
.DS_Store
._*

# Raster output is committed only where it is deliberately part of the site, so
# PNGs are ignored by default and assets/ is opted back in.
*.png
!assets/*.png
!assets/**/*.png
_local.html
